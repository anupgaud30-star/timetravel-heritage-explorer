# TimeTravel Voice Companion Environment Configuration

# Flask Server Settings
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False
SECRET_KEY=timetravel-heritage-secret-key-change-in-production

# AI Provider Configuration (OpenAI)
